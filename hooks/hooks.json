{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_loomcycle_)?loomcycle__spawn_run$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/capture-run-telemetry.sh\""
          }
        ]
      },
      {
        "matcher": "^mcp__(plugin_loomcycle_)?loomcycle__(spawn_run|spawn_runs|restore_snapshot|register_agent|unregister_agent|pause_runtime|resume_runtime)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto-snapshot-on-error.sh\""
          }
        ]
      }
    ]
  }
}
